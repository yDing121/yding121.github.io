---
<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    {% include head.liquid %}
    <link rel="stylesheet" href="{{ '/assets/css/fridge.css' | relative_url }}" />
  </head>
  <body class="fridge-body {% if site.navbar_fixed %}fixed-top-nav{% endif %}">
    {% include header.liquid %}
    <main id="fridge-root" class="fridge-root">
      {{ content }}
    </main>
    {% include scripts.liquid %}
    <script type="module" src="{{ page.entry_script | relative_url }}"></script>
  </body>
</html>
